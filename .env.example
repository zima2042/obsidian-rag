# ============================================================
# 复制为 .env 并填入你自己的值（.env 已被 .gitignore 排除）
# ============================================================

# ---- Obsidian 库路径 ----
VAULT_PATH=C:\Users\YourName\Documents\Obsidian Vault
OBSIDIAN_VAULT=C:\Users\YourName\Documents\Obsidian Vault

# ---- 用户身份（用于「我/我的」检索扩展，可留空）----
USER_NAME=示例用户
USER_STUDENT_ID=0000000000
USER_MAJOR=示例专业类
USER_COLLEGE=示例学院
USER_CLASS=00000000班

# ---- 学院目录名 / QQ 频道 ----
COLLEGE_FOLDER=学院
QQ_CHANNEL_NAME=频道名
QQ_CHANNEL_URL=https://pd.qq.com/g/your-channel-id

# ---- 教务 / 学院官网地址 ----
JW_BASE=http://jw.example.edu.cn
JW_LOGIN_URL=http://jw.example.edu.cn/tysfrz/navication.php?id=user
COLLEGE_BASE=https://ee.example.edu.cn
EE_BASE=https://ee.example.edu.cn

# ---- 云端生成模型 API key（也可放在 ~/.hermes/.env）----
# SENSENOVA_K7_API_KEY=your-api-key
